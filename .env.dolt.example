# bd(beads)のDoltリモート(共有Dolt sql-server)接続に使う認証情報。
# 実際の値を設定した .env.dolt をこのファイルと同じ場所(リポジトリ直下)に
# 作って使う。.env.dolt はgitignore対象。
#
#   cp .env.dolt.example .env.dolt
#
# コンテナ起動時にdocker-compose.ymlのenv_file経由でコンテナの環境変数として
# 注入される(docker compose exec -Tの非対話実行でも渡る)。

DOLT_REMOTE_USER=sinsjr
DOLT_REMOTE_PASSWORD=changeme
